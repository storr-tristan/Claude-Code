# Server Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=*

# Google Ads API Credentials
# Get credentials from: https://developers.google.com/google-ads/api/docs/oauth/overview
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=

# Meta Ads API Credentials
# Get credentials from: https://developers.facebook.com/docs/marketing-api/get-started
META_ADS_ACCESS_TOKEN=
META_ADS_APP_ID=
META_ADS_APP_SECRET=

# Microsoft Ads API Credentials
# Get credentials from: https://docs.microsoft.com/en-us/advertising/guides/authentication-oauth
MICROSOFT_ADS_CLIENT_ID=
MICROSOFT_ADS_CLIENT_SECRET=
MICROSOFT_ADS_DEVELOPER_TOKEN=
MICROSOFT_ADS_REFRESH_TOKEN=

# Amazon Ads API Credentials
# Get credentials from: https://advertising.amazon.com/API/docs/en-us/get-started/how-to-use-api
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
AMAZON_ADS_REFRESH_TOKEN=
